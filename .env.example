# Im vertrauenswürdigen Heimnetz auf allen Host-Schnittstellen lauschen.
GEOPHOTO_BIND_ADDRESS=0.0.0.0
GEOPHOTO_WEB_PORT=8080
GEOPHOTO_HTTP_PORT=8088
GEOPHOTO_DATA_PATH=./data
GEOPHOTO_MAX_FILE_MB=500
GEOPHOTO_MAX_DATASET_GB=50

# Zuverlässige Redis-Queue
GEOPHOTO_QUEUE_GROUP=geophoto-workers
# Nach dieser Zeit ohne Claim-Heartbeat darf ein anderer Worker einen
# verwaisten Auftrag übernehmen.
GEOPHOTO_QUEUE_STALE_SECONDS=180
# Maximale Starts desselben Stream-Eintrags nach harten Worker-Ausfällen.
GEOPHOTO_QUEUE_MAX_CRASH_ATTEMPTS=3

# Optionale Dienste
DRONEDB_PORT=5000
DRONEDB_USERNAME=admin
# Vor LAN-Nutzung ändern.
DRONEDB_PASSWORD=password123
DRONEDB_ORG=geophoto
DRONEDB_PUBLIC_URL=

OPENWEBUI_PORT=3001
OPENWEBUI_PUBLIC_URL=

# Keine echten Zugangsdaten committen.

# Optionale DJI-Radiometrie (Linux x86-64 TSDK)
# DJI Thermal SDK wird nicht mit diesem Repository ausgeliefert.
DJI_TSDK_HOST_PATH=./dji-tsdk
DJI_TSDK_VERSION=


# gsplat / COLMAP CUDA
# 1 = CUDA-SIFT für Feature Extraction/Matching, 0 = CPU-Fallback.
GEOPHOTO_COLMAP_CUDA=1
# NVIDIA-Geräteindex für COLMAP. Standard: erste GPU.
GEOPHOTO_CUDA_DEVICE=0


# gsplat / COLMAP CUDA
# 1 = CUDA-SIFT für Feature Extraction und Matching, 0 = CPU-Fallback.
GEOPHOTO_COLMAP_CUDA=1
# NVIDIA-Geräteindex für COLMAP FeatureExtraction/FeatureMatching.
GEOPHOTO_CUDA_DEVICE=0
# Erwartete COLMAP-Laufzeitversion im gsplat-Container.
GEOPHOTO_COLMAP_VERSION=4.2.0
