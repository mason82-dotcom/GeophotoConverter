GEOPHOTO_HTTP_PORT=8088
GEOPHOTO_DATA_PATH=./data
GEOPHOTO_MAX_FILE_MB=500
GEOPHOTO_MAX_DATASET_GB=50

# Optional service ports
DRONEDB_PORT=5000
DRONEDB_USERNAME=admin
# DroneDB upstream ships with this development default. Change it before LAN exposure.
DRONEDB_PASSWORD=password123
DRONEDB_ORG=geophoto
OPENWEBUI_PORT=3001

# Open WebUI may be pointed at any OpenAI-compatible provider after startup.
# Do not commit real credentials.

# Optional DJI radiometric thermal processing (Linux x86-64 TSDK)
# DJI Thermal SDK binaries are not included in this repository.
DJI_TSDK_HOST_PATH=./dji-tsdk
DJI_TSDK_VERSION=
