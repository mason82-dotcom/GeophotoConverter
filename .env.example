# Listen on all host interfaces so application web services are reachable in the trusted home LAN.
GEOPHOTO_BIND_ADDRESS=0.0.0.0
GEOPHOTO_WEB_PORT=8080
GEOPHOTO_HTTP_PORT=8088
GEOPHOTO_DATA_PATH=./data

# Optional service ports
DRONEDB_PORT=5000
OPENWEBUI_PORT=3001

# Open WebUI may be pointed at any OpenAI-compatible provider after startup.
# Do not commit real credentials.
